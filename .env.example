# Canonical site origin, used for canonical URLs, sitemap, and OG tags.
PUBLIC_SITE_URL=https://melovian.example.com

# Base path for project-page deploys such as GitHub Pages.
# Leave empty for a custom domain served from the domain root.
# The deploy workflow sets this automatically.
# BASE_PATH=/Melovian-Web

# Content sources, default to sibling checkouts.
# MELOVIAN_DOCS_DIR=../Melovian/docs/en
# MELOVIAN_SHOWCASE_DIR=../Melovian/showcase
# MELOVIAN_EXTENSIONS_DIR=../Melovian-Extensions
# MELOVIAN_RELEASES_FEED=https://github.com/melovian-hq/Melovian/releases.atom
