{
  "name": "melovian-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "postinstall": "node scripts/sync-docs.mjs && node scripts/sync-extensions.mjs && node scripts/sync-changelog.mjs && node scripts/optimize-images.mjs && node scripts/og-images.mjs",
    "predev": "node scripts/sync-docs.mjs && node scripts/sync-extensions.mjs && node scripts/sync-changelog.mjs && node scripts/optimize-images.mjs && node scripts/og-images.mjs",
    "prebuild": "node scripts/sync-docs.mjs && node scripts/sync-extensions.mjs && node scripts/sync-changelog.mjs && node scripts/optimize-images.mjs && node scripts/og-images.mjs",
    "docs:sync": "node scripts/sync-docs.mjs",
    "extensions:sync": "node scripts/sync-extensions.mjs",
    "changelog:sync": "node scripts/sync-changelog.mjs",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/og-images.mjs",
    "dev": "vite dev",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "lighthouse": "pnpm build && lhci autorun",
    "deps:check": "knip",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm deps:check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.5.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "knip": "6.35.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "marked": "^18.0.12",
    "runed": "^0.37.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
